    ///
    /// Field | Name | Identifier | Id
    /// ---|---|---|---
{{
    for (const { fieldName, id, alias, name } of champions) {
        if (name.replace(/[^a-zA-Z0-9]+/, '') !== alias) {
}}
    /// `{{= fieldName }}` | "{{= name }}" | "{{= alias }}" | {{= id }}
{{
        }
    }
}}
    pub const fn identifier(self) -> Option<&'static str> {
        match self {
{{
    for (const { fieldName, name, alias } of champions) {
}}
            Self::{{= fieldName.padEnd(constNamePad) }} => Some("{{= alias }}"),
{{
    }
}}
            _ => None,
        }
    }

    /// If this is a classic version of a champion.
    ///
    /// * `true` if this is a classic champion.
    /// * `false` if this is a regular (modern) champion, or an unknown champion.
    pub const fn is_classic(self) -> bool {
        match self {
{{
    for (const { fieldName, jade } of champions) {
}}
            Self::{{= fieldName.padEnd(constNamePad) }} => {{= jade }},
{{
    }
}}
            _ => false,
        }
    }

    /// Converts any classic versions of a champion to their regular variant.
    ///
    /// Returns self unchanged for regular champions.
    pub const fn from_classic(self) -> Self {
        match self {
{{
    for (const { fieldName, jade, name } of champions) {
}}
            Self::{{= fieldName.padEnd(constNamePad) }} => Self::{{= constName(name) }},
{{
    }
}}
            other => other,
        }
    }

    /// Converts a regular champion to its classic variant, if possible.
    ///
    /// * `Some(classic)` for champions that are classic or have a classic variant.
    /// * `None` for champions that have no classic variant, and for unknown champions.
    pub const fn to_classic(self) -> Option<Self> {
        match self {
{{
    for (const { fieldName, jade, name } of champions) {
        const jadeFieldName = regToJade.get(name);
}}
            Self::{{= fieldName.padEnd(constNamePad) }} => {{? jadeFieldName }}Some(Self::{{= jadeFieldName }}){{??}}None{{?}},
{{
    }
}}
            _ => None,
