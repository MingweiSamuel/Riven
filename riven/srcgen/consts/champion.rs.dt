{{
    const dotUtils = require('./dotUtils.js');

    const constName = name => dotUtils.changeCase.constantCase(name).replace(/[^_A-Z0-9]+/g, '');
    const constNamePad = 22;

    const regToJade = new Map();
    const champions = require('./.champion.json')
        .filter(({ id }) => id > 0)
        /* Ignore strawberry and ruby (DOOM_BOT_) champions */
        .filter(({ alias }) => !alias.startsWith('Strawberry_') && !alias.startsWith('Ruby_'))
        /* Handle jade classic ids. */
        .map(champ => {
            champ.fieldName = constName(champ.name);
            if ((champ.jade = champ.alias.startsWith('Jade_'))) {
                regToJade.set(champ.name, champ.fieldName);
                champ.fieldName = 'CLASSIC_' + champ.fieldName;
            }
            return champ;
        })
        .sort(({ jade: jadeA, name: nameA }, { jade: jadeB, name: nameB }) =>
            (jadeA - jadeB) || (nameA.localeCompare(nameB)));
}}{{= dotUtils.preamble() }}

newtype_enum! {
    /// A League of Legends champion.
    ///
    /// This newtype acts as a C-like enum; each variant corresponds to an
    /// integer value. Using a newtype allows _unknown_ variants to be
    /// represented. This is important when Riot adds new champions.
    ///
    /// Field | Name | Identifier | Id
    /// ---|---|---|---
    /// `NONE` | None (no ban) | | -1
{{
    for (const { fieldName, id, alias, name } of champions) {
}}
    /// `{{= fieldName }}` | "{{= name }}" | "{{= alias }}" | {{= id }}
{{
    }
}}
    pub newtype_enum Champion(i32) {
        /// `-1`, none. Appears when a champion ban is not used in champ select.
        NONE = -1,

{{
    for (const { fieldName, id, alias, name } of champions) {
}}
        /// `{{= id }}`.
        {{= fieldName }} = {{= id }},
{{
    }
}}
    }
}

impl Champion {
    /// The champion's name (`en_US` localization).
    pub const fn name(self) -> Option<&'static str> {
        match self {
{{
    for (const { fieldName, name } of champions) {
}}
            Self::{{= fieldName.padEnd(constNamePad) }} => Some("{{= name }}"),
{{
    }
}}
            _ => None,
        }
    }

    /// The champion's identifier key. Somtimes called "key", "identifier", or "alias".
    /// This is mainly used in DDragon paths.
    ///
    /// This is generally the `en_US` name with spaces and punctuation removed,
